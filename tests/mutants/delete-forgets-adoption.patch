A delete that does not hand the node's children to its parent
leaves them linked up to an empty slot.

Caught-by: fuzz fuzz-pmp8 fuzz-rp2350 fuzz-smp2 fuzz-work test qemu-replay
Report: link up to a slot that is not a live, filled one
Witness: fuzz actor-handoff

diff --git a/kernel/cap.c b/kernel/cap.c
--- a/kernel/cap.c
+++ b/kernel/cap.c
@@ -196,7 +196,7 @@ static void clear_node(struct cap *n)
 static void detach(struct cap *n, bool adopt)
 {
     /* The children go right after n, so n leaves the ring as a leaf would. */
-    if (adopt && cap_child(n) != 0) {
+    if (adopt && 0 && cap_child(n) != 0) {
         splice_after(n, node(cap_child(n)), node(cap_prev(node(cap_child(n)))));
     }
     struct cap *pred = node(cap_prev(n));
