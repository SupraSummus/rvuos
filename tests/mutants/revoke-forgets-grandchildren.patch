@@ -189,7 +189,7 @@ bool cap_revoke_below(struct cap *root, bool preempt)
     while (root->child != 0) {
         LOOP_PAID(cap_revoke_below, node, "a node it clears");
         struct cap *n = node(root->child);
-        detach(n, true);
+        detach(n, false);
         clear_node(n);
