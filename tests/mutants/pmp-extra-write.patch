Every PMP entry a segment produces carries the write bit,
whatever the segment's rights say.
The PMP the self-check reads back no longer matches the running process's segments.

diff --git a/kernel/process.c b/kernel/process.c
--- a/kernel/process.c
+++ b/kernel/process.c
@@ -51,7 +51,7 @@
             return KERR_LIMIT;
         }
         img->addr[img->count] = s->a + s->b;
-        img->cfg[img->count] = PMP_A_TOR | rights_to_pmp(s->rights);
+        img->cfg[img->count] = PMP_A_TOR | rights_to_pmp(s->rights) | PMP_W;
         img->count++;
         prev_end = s->a + s->b;
     }
