The self-check sizes its copy of the PMP CSRs in bits rather than entries,
a frame thirty-two times what it needs,
and checking the PMP overflows the kernel's stack.

Caught-by: stack-depth

diff --git a/kernel/selfcheck.c b/kernel/selfcheck.c
--- a/kernel/selfcheck.c
+++ b/kernel/selfcheck.c
@@ -1528,7 +1528,7 @@
             fail("the core's regions wait to be loaded again", v2p(current), 0, 0);
         }
         /* The CSRs, hardwired entries included, must grant exactly what the current process's slots do. */
-        uint32_t addr[PMP_CSR_ENTRIES];
+        uint32_t addr[PMP_CSR_ENTRIES * 32];
         uint8_t cfg[PMP_CSR_ENTRIES];
         for (unsigned i = 0; i < pmp_entry_end; i++) {
             pmp_get(i, &addr[i], &cfg[i]);
