A turn on spare time ends at a call that stopped for an interrupt,
so another thread runs before the call is made again.

Caught-by: fuzz fuzz-pmp8 fuzz-rp2350 fuzz-smp2 fuzz-work qemu-replay
Report: a call stopped where its caller cannot make it again
Witness: fuzz spare-turn-waits-for-recall

diff --git a/kernel/sched.c b/kernel/sched.c
--- a/kernel/sched.c
+++ b/kernel/sched.c
@@ -1380,7 +1380,7 @@ static __attribute__((noinline)) void spare_look(struct core *core)
 /* Out of line past the common case, a turn nothing marked with nobody waiting, so that saves no registers. */
 static void spare_end(struct core *core)
 {
-    if (!core->recall && core->turn != NULL && (core->run_stale || core->run_queue != 0)) {
+    if (core->turn != NULL && (core->run_stale || core->run_queue != 0)) {
         spare_look(core);
     }
 }
