A timer that fires stays armed.
It would signal again on every later tick;
after a tick no armed timer is due.

diff --git a/kernel/sched.c b/kernel/sched.c
--- a/kernel/sched.c
+++ b/kernel/sched.c
@@ -154,7 +154,6 @@
             continue;
         }
         uint32_t bits = t->bits;
-        timer_set_bits(t, 0);
         sched_signal(timer_notification(t), bits);
     }
 }
