     sched_ticks += ticks;
     for (uint32_t c = 0; c < CORES; c++) {
         LOOP_BOUND(CORES);
-        cores[c].nearest_deadline = sched_ticks + NEAREST_NONE;
+        core->nearest_deadline = sched_ticks + NEAREST_NONE;
     }
     for (uint32_t i = 0; i < TIMER_LINES; i++) {
         LOOP_BOUND(TIMER_LINES);
