      */
     while (root->child != 0) {
         LOOP_PAID(cap_revoke_below, node, "a node it clears");
+        if (cap_stop_here(preempt)) {
+            return false;
+        }
         struct cap *n = node(root->child);
         if (n->type == CAP_RETYPED) {
             if (!pool_destroy(node_pool(n), NULL, preempt)) {
