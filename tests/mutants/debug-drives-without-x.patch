A Debug capability with any right halts the machine, traces it, ticks it, fires its interrupts or preempts a call,
so a child given the log only to write could stop every other process;
a call goes through only a capability with the rights its operation needs.

Caught-by: fuzz fuzz-pmp8 fuzz-rp2350 fuzz-smp2 fuzz-work test qemu-replay
Report: a call went through a capability without the rights its operation needs

diff --git a/kernel/syscall.c b/kernel/syscall.c
--- a/kernel/syscall.c
+++ b/kernel/syscall.c
@@ -979,11 +979,11 @@ struct op_shape {
 };
 static const struct op_shape op_shapes[OP_COUNT] = {
     [OP_DEBUG_WRITE] = { CAP_DEBUG, RIGHT_W, SHAPE_A123 },
-    [OP_DEBUG_HALT] = { CAP_DEBUG, RIGHT_X, SHAPE_A1 },
-    [OP_DEBUG_TRACE] = { CAP_DEBUG, RIGHT_X, 0 },
-    [OP_DEBUG_TICK] = { CAP_DEBUG, RIGHT_X, 0 },
-    [OP_DEBUG_IRQ] = { CAP_DEBUG, RIGHT_X, SHAPE_A1 },
-    [OP_DEBUG_PREEMPT] = { CAP_DEBUG, RIGHT_X, SHAPE_A1 },
+    [OP_DEBUG_HALT] = { CAP_DEBUG, 0, SHAPE_A1 },
+    [OP_DEBUG_TRACE] = { CAP_DEBUG, 0, 0 },
+    [OP_DEBUG_TICK] = { CAP_DEBUG, 0, 0 },
+    [OP_DEBUG_IRQ] = { CAP_DEBUG, 0, SHAPE_A1 },
+    [OP_DEBUG_PREEMPT] = { CAP_DEBUG, 0, SHAPE_A1 },
     [OP_CAP_COPY] = { CAP_CAPTABLE, RIGHT_W, SHAPE_A123 | SHAPE_RIGHTS_A3 },
     [OP_CAP_DELETE] = { CAP_CAPTABLE, RIGHT_W, SHAPE_A1 },
     [OP_CAP_REVOKE] = { CAP_CAPTABLE, RIGHT_W, SHAPE_A1 },
