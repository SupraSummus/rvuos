A core that runs a turn on spare time is not interrupted when a thread with time comes to wait on its run queue,
so that thread waits for the core's next trap, a tick at most, behind a turn nobody pays for.

Caught-by: fuzz-smp2
Report: a turn on spare time runs while a thread with time waits

diff --git a/kernel/core.c b/kernel/core.c
--- a/kernel/core.c
+++ b/kernel/core.c
@@ -239,7 +239,7 @@ void core_notify(struct core *c)
      */
     if (c != core_self() &&
         (c->turn == NULL || (__atomic_load_n(&c->in_user, __ATOMIC_ACQUIRE) &&
-                             (c->wake_tick - c->ticks > 1 || (c->run_queue != 0 && sched_spare_turn(c)))))) {
+                             (c->wake_tick - c->ticks > 1 || (false && c->run_queue != 0 && sched_spare_turn(c)))))) {
         c->interrupt_owed = true;
     }
 #else
