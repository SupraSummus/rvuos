      */
     while (pool->last != pool_base(pool)) {
         LOOP_PAID(pool_destroy, object, "an object of the pool, newest first");
+        if (cap_stop_here(preempt)) {
+            return false;
+        }
         struct obj_header *o = p2v(pool->last);
         struct cap *n;
         while ((n = held_node(o, &pool->sweep)) != NULL) {
