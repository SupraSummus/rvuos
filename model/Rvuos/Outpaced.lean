/-- The root task's thread, which revokes below `REPLAY_CAP_FREE`, and the second thread, which copies. -/
def root : Nat := 2148730224
def other : Nat := 2153776496
/-- `REPLAY_CAP_FREE` and the slot after it, in either table, and `REPLAY_CAP_TABLE`, the second thread's table. -/
def free0 : Nat := 32
def free1 : Nat := 33
def theirs : Nat := 26
def revoke : Event := .call root opCapRevoke [1, free0, 0, 0, 0]
def copy (dst src : Nat) : Event := .call other opCapCopy [theirs, dst, src, rightAll, 0]

def after (s : State) (e : Event) : List Outcome := (step machine s e).getD []

/-- A step of the revoke that stops, then the copy, in every outcome the model names. -/
def round (s : State) (dst src : Nat) : List State :=
  ((after s revoke).filter (·.ret == .again)).flatMap fun o => (after o.st (copy dst src)).map (·.st)

/-- From a forest, a round reaches a state from which two rounds more come back to it. -/
def comesBack : Bool :=
  before.wellFormed &&
    (round before free1 free0).any fun s1 =>
      (round s1 free0 free1).any fun s2 => (round s2 free1 free0).any fun s3 => s3.normal == s1.normal

/-- `native_decide` runs code Lean compiles, so this trusts Lean's compiler, as the `bv_decide` proofs do. -/
theorem revoke_outpaced : comesBack = true := by native_decide

